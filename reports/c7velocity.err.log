@interact
def plotoffax(betar):
    gamr = 1/np.sqrt(1-betar**2)
    th = np.pi/4
    beta = 0.866
    denom = 1-betar*beta*np.cos(th)
    bpx = (beta*np.cos(th)-betar)/denom
    bpy = beta*np.sin(th)/gamr/denom
    plt.arrow(0,0,bpx,bpy,head_width=0.1)

interact(plotoffax, betar = widgets.FloatSlider(value=0., min=-0.99, max=0.99, step=0.01))
